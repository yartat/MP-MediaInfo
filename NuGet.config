<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
	<clear />
    <add key="NuGet" value="https://api.nuget.org/v3/index.json" />
    <!--
      Relative to this file, and with forward slashes, so that a restore from WSL
      or from a Linux container resolves it as well as one from Windows does. An
      absolute Windows path here fails on Linux with NU1301 before any package is
      even looked for.
    -->
    <add key="Local" value="../MP-MediaInfo.Native/artifacts" />
  </packageSources>
</configuration>