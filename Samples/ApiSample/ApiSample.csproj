<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>3ac0dbeb-4d8a-479e-b111-5efb8f1d0e6d</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>

    <!--
      The OpenAPI document takes its summaries and descriptions from the XML
      comments, which .NET 10 reads at compile time rather than from a file at
      startup. CS1591 stays off: this is a sample, and not every member carries a
      comment.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mapster" Version="$(MapsterLib)" />
    <PackageReference Include="Mapster.DependencyInjection" Version="$(MapsterDILib)" />

    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="$(AzureContainer)" />

    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="$(Net10x)" />
    <PackageReference Include="Scalar.AspNetCore" Version="$(Scalar)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MediaInfo.Wrapper\MediaInfo.Wrapper.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\Test_H264.m2ts">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
